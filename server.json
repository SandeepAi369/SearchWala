{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SandeepAi369/searchwala",
  "title": "SearchWala",
  "description": "Private 19-engine meta-search, domain-filtered web scraping, and focused extraction MCP server.",
  "websiteUrl": "https://github.com/SandeepAi369/SearchWala#built-in-mcp-server-zero-dependencies",
  "repository": {
    "url": "https://github.com/SandeepAi369/SearchWala",
    "source": "github"
  },
  "version": "8.3.1",
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "searchwala",
      "version": "8.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
